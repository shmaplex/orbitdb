{
  "plugins": [
    "plugins/markdown"
  ],
  "source": {
    "include": [
      "src"
    ],
    "includePattern": ".+\\.ts$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "destination": "./docs/api",
    "recurse": true,
    "template": "conf/jsdoc/layout.tmpl"
  },
  "templates": {
    "default": {
      "layoutFile": "conf/jsdoc/layout.tmpl"
    }
  }
}